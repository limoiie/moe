{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Moe",
  "version": "0.1.0",
  "identifier": "app.moe.desktop",
  "build": {
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "pnpm dev"
    },
    "beforeBuildCommand": {
      "cwd": "../../ui",
      "script": "pnpm build"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Moe",
        "width": 768,
        "height": 530,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "label": "chat",
        "title": "Moe Chat",
        "url": "chat.html",
        "width": 460,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "shadow": true,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "Moe Settings",
        "url": "settings.html",
        "width": 880,
        "height": 640,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "decorations": true,
        "transparent": false,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "shadow": true,
        "acceptFirstMouse": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
